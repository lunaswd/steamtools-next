{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local Steam and OpenSteamTool management window.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-scan-steam-command",
    "allow-current-steam-session-command",
    "allow-extract-current-session-command",
    "allow-export-current-session-command",
    "allow-detect-kernel-installation-command",
    "allow-scan-lua-library-command",
    "allow-add-lua-entry-command",
    "allow-import-library-files-command",
    "allow-import-library-archives-command",
    "allow-set-lua-entry-enabled-command",
    "allow-delete-lua-entry-command",
    "allow-search-catalog-command",
    "allow-list-achievements-command",
    "allow-apply-achievement-changes-command",
    "allow-load-game-cover-command",
    "allow-load-achievement-image-command",
    "allow-catalog-rankings-command",
    "allow-refresh-key-cache-command",
    "allow-catalog-add-command",
    "allow-remote-library-import-command",
    "allow-install-remote-kernel-command",
    "allow-uninstall-kernel-command",
    "allow-poll-manifest-command",
    "allow-load-settings-command",
    "allow-save-settings-command",
    "allow-get-environment-command",
    "allow-export-report-command",
    "allow-steam-account-state-command",
    "allow-restart-steam-command",
    "allow-relogin-steam-command",
    "allow-switch-saved-steam-account-command",
    "allow-check-updates-command",
    "allow-install-tool-update-command",
    "allow-authorization-session-command",
    "allow-inspect-authorization-ticket-command",
    "allow-extract-authorization-ticket-command",
    "allow-import-authorization-ticket-command"
  ]
}
