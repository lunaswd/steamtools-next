{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SteamTools Next",
  "version": "0.3.0",
  "identifier": "io.steamtoolsnext.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SteamTools Next v0.3.0",
        "width": 1360,
        "height": 880,
        "minWidth": 960,
        "minHeight": 680,
        "center": true,
        "backgroundColor": "#101211"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: https:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico"
    ],
    "shortDescription": "Steam Lua library and OpenSteamTool manager",
    "category": "Utility"
  }
}
